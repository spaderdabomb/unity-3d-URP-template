<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/MainMenuStyle.uss?fileID=7433441132597879392&amp;guid=cf0fedd740ff9b64bb184b4f9e51711e&amp;type=3#MainMenuStyle" />
    <ui:VisualElement name="GameBg" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Art/GameBg.png?fileID=2800000&amp;guid=e23e364b4d1b3e840b3d11b8a4301e49&amp;type=3#GameBg&quot;); justify-content: center; align-items: center;">
        <ui:VisualElement name="MainMenuContainer" style="flex-grow: 0; width: 800px; height: 800px; background-color: rgba(0, 0, 0, 0.98); border-left-color: rgba(230, 230, 230, 0.59); border-right-color: rgba(230, 230, 230, 0.59); border-top-color: rgba(230, 230, 230, 0.59); border-bottom-color: rgba(230, 230, 230, 0.59); border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; padding-top: 20px; padding-right: 20px; padding-bottom: 20px; padding-left: 20px;">
            <ui:Label tabindex="-1" text="Main Menu" parse-escape-sequences="true" display-tooltip-when-elided="true" name="MainMenuHeaderLabel" style="font-size: 70px; color: rgb(230, 230, 230); -unity-font-style: bold; -unity-text-align: middle-center;" />
            <ui:VisualElement style="flex-grow: 0; height: 2px; background-color: rgb(230, 230, 230); margin-top: 5px;" />
            <ui:VisualElement name="ButtonContainer" style="flex-grow: 1; justify-content: center; align-items: center;">
                <ui:Button text="Settings" parse-escape-sequences="true" display-tooltip-when-elided="true" name="SettingsButton" class="main-menu-button settings-button" />
                <ui:Button text="Achievements" parse-escape-sequences="true" display-tooltip-when-elided="true" name="AchievementsButton" class="main-menu-button achievements-button" />
                <ui:Button text="Play" parse-escape-sequences="true" display-tooltip-when-elided="true" name="PlayButton" class="main-menu-button play-button" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
